{
  "name": "lambda",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 4900",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 4900",
    "lint": "eslint",
    "test": "vitest run",
    "app:dev": "electron electron/app",
    "app:icon": "node electron/scripts/make-icon.mjs",
    "app:build": "LAMBDA_APP_BUILD=1 next build && node electron/scripts/prepare.mjs && electron-builder --config electron/builder.json --mac",
    "app:open": "open dist/mac-arm64/lambda.app",
    "app:install": "test -d dist/mac-arm64/lambda.app && rm -rf /Applications/lambda.app && ditto dist/mac-arm64/lambda.app /Applications/lambda.app"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@dagrejs/dagre": "^3.1.3",
    "@xyflow/react": "^12.12.0",
    "clsx": "^2.1.1",
    "libpg-query": "18.2.1",
    "motion": "^14.7.1",
    "nanoid": "^6.0.2",
    "next": "16.4.3",
    "pgsql-parser": "18.3.1",
    "playwright": "^1.64.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "roughjs": "^4.6.6",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^38.8.6",
    "electron-builder": "^26.18.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "3.2.4"
  }
}
